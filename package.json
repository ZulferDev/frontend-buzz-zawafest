{
  "name": "lcc-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev-termux.js",
    "dev:frontend": "vite --host 0.0.0.0 --port 5173",
    "dev:backend": "cd backend-go && go run ./cmd/server",
    "dev:backend:legacy": "npm run dev --workspace backend",
    "build": "vite build",
    "test:backend:go": "cd backend-go && go test ./...",
    "preview": "vite preview",
    "test:backend": "npm test --workspace backend",
    "test:e2e": "playwright test tests/backend-migration.spec.ts tests/buzzer-resilience.spec.ts tests/full-app.spec.ts --project=chromium --workers=1",
    "test:e2e:dev": "ZAWA_E2E_USE_DEV_SERVERS=1 ZAWA_E2E_FRONTEND_URL=http://127.0.0.1:5173 ZAWA_E2E_BACKEND_URL=http://127.0.0.1:3000 playwright test tests/full-app.spec.ts --project=chromium --workers=1"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "vite": "^6.4.1"
  }
}
